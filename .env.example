# Home Meal Planner — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env.local` or any file with real secrets (see .gitignore).
# Use SEPARATE Supabase + Vercel projects for dev and prod (design/02 § Environments).

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose to the browser.
# Found in Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service-role key — bypasses Row-Level Security.
# SERVER / EDGE FUNCTIONS / CRON JOBS ONLY. Never expose to the browser and
# never import into a user-request path (design/02 § Supabase client strategy).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local dev (run `supabase start`): the CLI prints a fixed local URL + demo keys.
# Use these in .env.local for local development instead of the cloud values above:
#   NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY → copy from `supabase start` output.
# See supabase/README.md for the full local workflow.

# ── Supabase Auth providers (Google OAuth) ───────────────────────────────────
# Read by the Supabase CLI to enable the Google provider (supabase/config.toml
# → [auth.external.google]; design/03 § 2). The CLI auto-loads `.env` (NOT
# `.env.local`), so for local Google sign-in either put these in `.env` or run
# `supabase start --env-file .env.local`. The provider is enabled in config.toml in P1-1.
# Create credentials in Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID (Web); add redirect URI http://localhost:54321/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="your-google-oauth-client-id"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="your-google-oauth-client-secret"

# ── Email (transactional) ────────────────────────────────────────────────────
# Resend API key, used by the EmailNotifier for invites (design/09 § adapters).
# When unset, the email adapter is a best-effort no-op (the invite link is still
# returned for manual sharing), so local dev needs no email provider.
RESEND_API_KEY="re_your_api_key"
# Optional "From" address for invite emails. Defaults to Resend's test sender
# (onboarding@resend.dev); set a verified-domain address in production.
RESEND_FROM_EMAIL="Home Meal Planner <onboarding@resend.dev>"

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app. Read when building absolute invite links (the
# invite API falls back to the request origin when unset). OAuth/magic-link
# redirects derive from the request origin, not this variable.
# Local: http://localhost:3000 — Prod: your deployed app URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Note: the Supabase MCP server (.mcp.json) authenticates via browser OAuth — no
# token needed here. Run `/mcp` in Claude Code and sign in. See supabase/README.md.
