# Home Meal Planner — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env.local` or any file with real secrets (see .gitignore).
# Use SEPARATE Supabase + Vercel projects for dev and prod (design/02 § Environments).

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose to the browser.
# Found in Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service-role key — bypasses Row-Level Security.
# SERVER / EDGE FUNCTIONS / CRON JOBS ONLY. Never expose to the browser and
# never import into a user-request path (design/02 § Supabase client strategy).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Email (transactional) ────────────────────────────────────────────────────
# Resend API key, used by the EmailNotifier for invites (design/09 § adapters).
RESEND_API_KEY="re_your_api_key"

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app. Used for OAuth redirect callbacks and invite links.
# Local: http://localhost:3000 — Prod: your deployed Vercel URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
