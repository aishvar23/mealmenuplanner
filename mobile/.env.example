# Mobile app environment (Expo inlines EXPO_PUBLIC_* into the bundle).
# Copy to `mobile/.env` and fill in. See mobile/src/config.ts.

# The Next.js /api host. Prod is https://mymealtoday.com.
# For local dev against the :3100 clone, use your machine's LAN IP on a device:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3100
EXPO_PUBLIC_API_BASE_URL=https://mymealtoday.com

# Supabase Auth — same cloud-dev project the web app uses. Anon key is
# client-safe (RLS still applies).
EXPO_PUBLIC_SUPABASE_URL=https://dultruvperqxtqtbochp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
