# Home Meal Planner — E2E (Playwright) environment overlay
#
# Copy to `.env.e2e` and fill in. This file is an OPTIONAL overlay on top of
# `.env.local`: playwright.config.ts loads `.env.local` first, then `.env.e2e`
# (override). If your `.env.local` already points at the cloud-dev Supabase and
# has SUPABASE_SERVICE_ROLE_KEY, you only need the e2e-specific bits below.
#
# The e2e suite signs in with REAL email/password (no Google/magic-link mocking)
# and provisions its test accounts with the service-role key — so the one hard
# requirement is a valid SUPABASE_SERVICE_ROLE_KEY plus the public Supabase vars.

# ── Supabase (cloud dev) ──────────────────────────────────────────────────────
# Usually already present in .env.local; repeat here only to override.
NEXT_PUBLIC_SUPABASE_URL="https://your-dev-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# REQUIRED for e2e: used (outside the app) to provision/clean up the spec users
# and to delete ephemeral households during teardown. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── E2E knobs ─────────────────────────────────────────────────────────────────
# Shared password for the seeded spec users and the per-test ephemeral users.
# Must satisfy Supabase's minimum password length.
E2E_USER_PASSWORD="e2e-Password-1234"

# Base URL the suite drives + the dev server Playwright boots. Defaults to
# http://localhost:3000 when unset.
# E2E_BASE_URL="http://localhost:3000"
