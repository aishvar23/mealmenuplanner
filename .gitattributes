# Normalize line endings: store everything as LF in the repo.
# Prevents CRLF noise when developing on Windows and running CI on Linux.
* text=auto eol=lf

# Explicitly enforce LF for source and config we own.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Treat lockfiles as generated in diffs/merges.
package-lock.json linguist-generated=true -diff

# Binary files: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
